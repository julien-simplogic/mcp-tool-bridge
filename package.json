{
  "name": "mcp-tool-bridge",
  "version": "1.1.1",
  "description": "A generic MCP server that exposes a declared tool catalog to a model, with role-based filtering and a server-side confirmation guard.",
  "license": "MIT",
  "author": "Julien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julien-simplogic/mcp-tool-bridge.git"
  },
  "homepage": "https://github.com/julien-simplogic/mcp-tool-bridge#readme",
  "bugs": {
    "url": "https://github.com/julien-simplogic/mcp-tool-bridge/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "tools",
    "agents",
    "rbac",
    "confirmation"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check:dist": "node scripts/check-dist.mjs && node scripts/check-dist.cjs",
    "check:mutations": "node scripts/check-mutations.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run check:dist"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
