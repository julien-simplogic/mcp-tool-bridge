# The library itself reads no environment variable: the host passes everything
# explicitly. These variables are only read by examples/minimal.

# Who the example stdio server acts for. Under stdio there is no per-request
# authentication: the identity is fixed when the process is launched.
EXAMPLE_PRINCIPAL_ID=alice
# Comma-separated. Try "reader" alone to see the write tools disappear.
EXAMPLE_PRINCIPAL_ROLES=reader,editor
