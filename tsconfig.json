{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // The examples import the package by name, as users would; typecheck and
    // tsx resolve it to the sources, so no build is needed to run them.
    "paths": {
      "mcp-tool-bridge": ["./src/index.ts"],
      "mcp-tool-bridge/zod": ["./src/schema/zod.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "examples", "scripts", "*.config.ts"]
}
